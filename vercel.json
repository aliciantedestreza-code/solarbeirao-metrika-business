{
 "cleanUrls": false,
 "headers": [
  {
   "source": "/painel.html",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/(.*)\\.html",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  },
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/(.*)\\.(js|css)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=300, must-revalidate"
    }
   ]
  },
  {
   "source": "/contacto.vcf",
   "headers": [
    {
     "key": "Content-Type",
     "value": "text/vcard; charset=utf-8"
    },
    {
     "key": "Content-Disposition",
     "value": "inline; filename=\"Solar-Beirao.vcf\""
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    }
   ]
  }
 ]
}